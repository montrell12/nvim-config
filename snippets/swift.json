    "prefix": "extproto",
    "body": [
      "extension ${1:Type}: ${2:Protocol} {",
      "    $0",
      "}"
    ],
    "description": "Extension with protocol conformance"
  },
  "Computed Property": {
    "prefix": "computed",
    "body": [
      "var ${1:name}: ${2:Type} {",
      "    $0",
      "}"
    ],
    "description": "Computed property"
  },
  "Closure": {
    "prefix": "closure",
    "body": "{ ${1:params} in\n    $0\n}",
