  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "    case ${2:case1}",
      "    case ${3:case2}",
      "    $0",
      "}"
    ],
    "description": "Enum definition"
  },
  "Enum String": {
    "prefix": "enumstring",
    "body": [
      "enum ${1:Name}: String, CaseIterable {",
      "    case ${2:case1} = \"${3:value1}\"",
      "    case ${4:case2} = \"${5:value2}\"",
      "    $0",
      "}"
    ],
    "description": "String enum"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
