  },
  "UserDefaults Get": {
    "prefix": "userdefget",
    "body": "UserDefaults.standard.${1:string}(forKey: \"${2:key}\")",
    "description": "UserDefaults get value"
  },
  "UserDefaults Set": {
    "prefix": "userdefset",
    "body": "UserDefaults.standard.set(${1:value}, forKey: \"${2:key}\")",
    "description": "UserDefaults set value"
  }
}
