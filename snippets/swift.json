{
  "SwiftUI View Container": {
    "prefix": "viewcontainer",
    "body": [
      "import SwiftUI",
      "",
      "struct ${1:ContainerName}View: View {",
      "    var body: some View {",
      "        ${2:VStack} {",
      "            $0",
      "        }",
      "    }",
      "}",
      "",
      "#Preview {",
      "    ${1:ContainerName}View()",
      "}"
    ],
    "description": "SwiftUI View container template with import and preview"
  },
  "SwiftUI View": {
    "prefix": "swiftview",
    "body": [
      "struct ${1:ViewName}: View {",
      "    var body: some View {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Basic SwiftUI View struct"
  },
  "SwiftUI State": {
    "prefix": "state",
    "body": "@State private var ${1:name}: ${2:Type} = ${3:value}",
    "description": "@State property wrapper"
  },
  "SwiftUI Binding": {
    "prefix": "binding",
    "body": "@Binding var ${1:name}: ${2:Type}",
    "description": "@Binding property wrapper"
  },
  "SwiftUI StateObject": {
    "prefix": "stateobj",
    "body": "@StateObject private var ${1:viewModel} = ${2:ViewModel}()",
    "description": "@StateObject property wrapper"
  },
  "SwiftUI ObservedObject": {
    "prefix": "observed",
    "body": "@ObservedObject var ${1:viewModel}: ${2:ViewModel}",
    "description": "@ObservedObject property wrapper"
  },
  "SwiftUI EnvironmentObject": {
    "prefix": "envobj",
    "body": "@EnvironmentObject var ${1:name}: ${2:Type}",
    "description": "@EnvironmentObject property wrapper"
  },
  "SwiftUI Environment": {
    "prefix": "env",
    "body": "@Environment(\\.${1:keyPath}) var ${2:name}",
    "description": "@Environment property wrapper"
  },
  "SwiftUI Published": {
    "prefix": "published",
    "body": "@Published var ${1:name}: ${2:Type} = ${3:value}",
    "description": "@Published property wrapper"
  },
  "SwiftUI AppStorage": {
    "prefix": "appstorage",
    "body": "@AppStorage(\"${1:key}\") var ${2:name}: ${3:Type} = ${4:defaultValue}",
    "description": "@AppStorage property wrapper"
  },
  "ObservableObject ViewModel": {
    "prefix": "viewmodel",
    "body": [
      "class ${1:Name}ViewModel: ObservableObject {",
      "    @Published var ${2:property}: ${3:Type} = ${4:value}",
      "    ",
      "    init() {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "ObservableObject ViewModel class"
  },
  "Observable Class": {
    "prefix": "observable",
    "body": [
      "@Observable",
      "class ${1:Name} {",
      "    var ${2:property}: ${3:Type} = ${4:value}",
      "    ",
      "    init() {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Swift 5.9 @Observable class"
  },
  "VStack": {
    "prefix": "vstack",
    "body": [
      "VStack(${1:alignment: .leading, spacing: 8}) {",
      "    $0",
      "}"
    ],
    "description": "VStack container"
  },
  "HStack": {
    "prefix": "hstack",
    "body": [
      "HStack(${1:alignment: .center, spacing: 8}) {",
      "    $0",
      "}"
    ],
    "description": "HStack container"
  },
  "ZStack": {
    "prefix": "zstack",
    "body": [
      "ZStack(${1:alignment: .center}) {",
      "    $0",
      "}"
