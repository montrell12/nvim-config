  },
  "Print Debug": {
    "prefix": "printd",
    "body": "print(\"DEBUG: ${1:message} - \\(${2:value})\")",
    "description": "Debug print statement"
  },
  "Main Actor": {
    "prefix": "mainactor",
    "body": "@MainActor",
    "description": "@MainActor attribute"
  },
  "Main Actor Block": {
    "prefix": "mainactorblock",
    "body": [
      "await MainActor.run {",
      "    $0",
      "}"
    ],
    "description": "MainActor.run block"
  },
  "Dispatch Main": {
    "prefix": "dispatchmain",
    "body": [
