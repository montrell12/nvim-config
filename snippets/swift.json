  },
  "LazyHStack": {
    "prefix": "lazyhstack",
    "body": [
      "LazyHStack(${1:alignment: .center, spacing: 8}) {",
      "    $0",
      "}"
    ],
    "description": "LazyHStack container"
  },
  "ScrollView": {
    "prefix": "scrollview",
    "body": [
      "ScrollView(${1:.vertical, showsIndicators: false}) {",
      "    $0",
      "}"
    ],
    "description": "ScrollView container"
  },
  "List": {
    "prefix": "list",
    "body": [
      "List {",
      "    ForEach(${1:items}) { ${2:item} in",
      "        $0",
      "    }",
      "}"
    ],
    "description": "List with ForEach"
  },
  "ForEach": {
    "prefix": "foreach",
    "body": [
      "ForEach(${1:items}) { ${2:item} in",
      "    $0",
      "}"
    ],
    "description": "ForEach loop"
  },
  "ForEach Indexed": {
    "prefix": "foreachindex",
    "body": [
      "ForEach(Array(${1:items}.enumerated()), id: \\.offset) { index, ${2:item} in",
      "    $0",
      "}"
    ],
    "description": "ForEach with index"
  },
  "NavigationStack": {
    "prefix": "navstack",
    "body": [
      "NavigationStack {",
      "    $0",
      "    .navigationTitle(\"${1:Title}\")",
      "}"
    ],
    "description": "NavigationStack container"
  },
  "NavigationLink": {
    "prefix": "navlink",
    "body": [
      "NavigationLink {",
      "    ${1:DestinationView}()",
      "} label: {",
      "    $0",
      "}"
    ],
    "description": "NavigationLink with destination"
  },
  "Sheet": {
    "prefix": "sheet",
    "body": ".sheet(isPresented: $${1:isPresented}) {\n    $0\n}",
    "description": "Sheet modifier"
  },
  "FullScreenCover": {
    "prefix": "fullscreen",
    "body": ".fullScreenCover(isPresented: $${1:isPresented}) {\n    $0\n}",
    "description": "FullScreenCover modifier"
  },
  "Alert": {
    "prefix": "alert",
    "body": [
      ".alert(\"${1:Title}\", isPresented: $${2:showAlert}) {",
      "    Button(\"OK\", role: .cancel) { }",
      "} message: {",
      "    Text(\"${3:Message}\")",
      "}"
    ],
    "description": "Alert modifier"
  },
  "Task": {
    "prefix": "task",
    "body": [
      ".task {",
      "    $0",
      "}"
    ],
    "description": "Task modifier for async work"
  },
  "OnAppear": {
    "prefix": "onappear",
    "body": [
      ".onAppear {",
      "    $0",
      "}"
    ],
    "description": "onAppear modifier"
  },
  "OnChange": {
    "prefix": "onchange",
    "body": [
      ".onChange(of: ${1:value}) { oldValue, newValue in",
      "    $0",
      "}"
    ],
    "description": "onChange modifier (iOS 17+)"
  },
  "Button": {
    "prefix": "button",
    "body": [
      "Button {",
      "    $2",
      "} label: {",
      "    Text(\"${1:Label}\")",
      "}"
    ],
    "description": "Button with action"
  },
  "Button Simple": {
    "prefix": "buttonsimple",
    "body": "Button(\"${1:Label}\") {\n    $0\n}",
    "description": "Simple button"
  },
  "TextField": {
    "prefix": "textfield",
    "body": "TextField(\"${1:Placeholder}\", text: $${2:text})",
    "description": "TextField"
  },
  "SecureField": {
    "prefix": "securefield",
    "body": "SecureField(\"${1:Placeholder}\", text: $${2:password})",
    "description": "SecureField for passwords"
  },
  "Image SF Symbol": {
    "prefix": "imgsf",
    "body": "Image(systemName: \"${1:star.fill}\")",
    "description": "SF Symbol image"
  },
  "AsyncImage": {
    "prefix": "asyncimage",
    "body": [
      "AsyncImage(url: URL(string: ${1:urlString})) { phase in",
      "    switch phase {",
      "    case .empty:",
      "        ProgressView()",
      "    case .success(let image):",
      "        image",
      "            .resizable()",
      "            .aspectRatio(contentMode: .fit)",
      "    case .failure:",
      "        Image(systemName: \"photo\")",
      "    @unknown default:",
      "        EmptyView()",
      "    }",
      "}"
    ],
    "description": "AsyncImage with phases"
  },
  "Async Function": {
    "prefix": "asyncfunc",
    "body": [
      "func ${1:fetchData}() async ${2:throws} {",
      "    $0",
      "}"
    ],
    "description": "Async function"
  },
  "Async Throwing Function": {
    "prefix": "asyncthrows",
    "body": [
      "func ${1:fetchData}() async throws -> ${2:Type} {",
      "    $0",
      "}"
    ],
    "description": "Async throwing function with return"
  },
  "Do Try Catch": {
    "prefix": "dotry",
    "body": [
      "do {",
      "    ${1:try await something()}",
      "} catch {",
      "    print(\"Error: \\(error)\")",
      "    $0",
      "}"
    ],
    "description": "Do-try-catch block"
  },
  "Guard Let": {
    "prefix": "guardlet",
    "body": [
      "guard let ${1:unwrapped} = ${2:optional} else {",
      "    ${3:return}",
      "}",
      "$0"
    ],
    "description": "Guard let unwrap"
  },
  "Guard Else": {
    "prefix": "guardelse",
    "body": [
      "guard ${1:condition} else {",
      "    ${2:return}",
      "}",
      "$0"
    ],
    "description": "Guard else"
  },
  "If Let": {
    "prefix": "iflet",
    "body": [
      "if let ${1:unwrapped} = ${2:optional} {",
      "    $0",
      "}"
    ],
    "description": "If let unwrap"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    $0",
      "}"
    ],
    "description": "Struct definition"
  },
  "Struct Codable": {
    "prefix": "structcodable",
    "body": [
      "struct ${1:Name}: Codable {",
