  "GeometryReader": {
    "prefix": "geometry",
    "body": [
      "GeometryReader { geometry in",
      "    $0",
      "}"
    ],
    "description": "GeometryReader"
  },
  "Modifier": {
    "prefix": "modifier",
    "body": [
      "struct ${1:Name}Modifier: ViewModifier {",
      "    func body(content: Content) -> some View {",
      "        content",
      "            $0",
      "    }",
      "}"
    ],
    "description": "Custom ViewModifier"
  },
  "Animation": {
    "prefix": "withanim",
