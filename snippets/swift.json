  },
  "API Request": {
    "prefix": "apirequest",
    "body": [
      "func ${1:fetchData}() async throws -> ${2:ResponseType} {",
      "    guard let url = URL(string: \"${3:https://api.example.com/endpoint}\") else {",
      "        throw URLError(.badURL)",
      "    }",
      "    ",
      "    let (data, response) = try await URLSession.shared.data(from: url)",
      "    ",
      "    guard let httpResponse = response as? HTTPURLResponse,",
      "          (200...299).contains(httpResponse.statusCode) else {",
      "        throw URLError(.badServerResponse)",
      "    }",
      "    ",
      "    return try JSONDecoder().decode(${2:ResponseType}.self, from: data)",
      "}"
    ],
    "description": "Async API request function"
  },
  "Preview": {
    "prefix": "preview",
    "body": [
      "#Preview {",
      "    ${1:ViewName}()",
      "}"
    ],
    "description": "SwiftUI Preview macro"
  },
  "Preview with Binding": {
    "prefix": "previewbinding",
    "body": [
      "#Preview {",
      "    @Previewable @State var ${1:value} = ${2:defaultValue}",
      "    ${3:ViewName}(${4:binding}: $${1:value})",
      "}"
    ],
    "description": "Preview with @Previewable State"
  },
  "Mark": {
    "prefix": "mark",
